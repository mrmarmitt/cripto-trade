<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    
    <!-- Register custom converter -->
    <conversionRule conversionWord="cMDC" class="com.marmitt.application.spring.config.logback.ConditionalMDCConverter" />
    
    <!-- Console Appender with Pattern including correlationId -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %cMDC{correlationId,correlation}%cMDC{exchangeName,exchange}%cMDC{connectionId,conn}%logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Reduce Spring Boot startup noise -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.context" level="WARN"/>
    <logger name="org.springframework.boot.autoconfigure" level="WARN"/>
    
    <!-- Reduce Netty noise -->
    <logger name="io.netty" level="WARN"/>
    
    <!-- Loki appender — non-blocking batch push; fails silently when Loki is unreachable -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${LOKI_URL:-http://loki:3100}/loki/api/v1/push</url>
        </http>
        <batch>
            <timeoutMs>5000</timeoutMs>
        </batch>
        <format>
            <label>
                <pattern>app=ctrade,host=${HOSTNAME:-local},level=%level</pattern>
                <readMarkers>true</readMarkers>
            </label>
            <message class="com.github.loki4j.logback.JsonLayout">
                <mdcPrefix></mdcPrefix>
            </message>
        </format>
    </appender>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI"/>
    </root>

</configuration>