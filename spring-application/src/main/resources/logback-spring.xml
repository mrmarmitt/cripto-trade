<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    
    <!-- Register custom converter -->
    <conversionRule conversionWord="cMDC" converterClass="com.marmitt.application.spring.config.logback.ConditionalMDCConverter" />
    
    <!-- Console Appender with Pattern including correlationId -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %cMDC{correlationId,correlation}%cMDC{exchangeName,exchange}%cMDC{connectionId,conn}%logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- File Appender for general application logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %cMDC{correlationId,correlation}%cMDC{exchangeName,exchange}%cMDC{connectionId,conn}%logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/application.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- Separate Appender for Message Processing with correlationId -->
    <appender name="MESSAGE_PROCESSING" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/message-processing.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %cMDC{correlationId,correlation}%cMDC{exchangeName,exchange}%cMDC{connectionId,conn}%logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/message-processing.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- Error Appender for error-level logs only -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/errors.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %cMDC{correlationId,correlation}%cMDC{exchangeName,exchange}%cMDC{connectionId,conn}%logger{36} - %msg%n%ex</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/errors.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>
    
    <!-- Logger for Message Processing with dedicated appender -->
    <logger name="com.marmitt.handler" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="MESSAGE_PROCESSING"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>
    
    <!-- Logger for Core UseCase processing -->
    <logger name="com.marmitt.core.application.usecase" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="MESSAGE_PROCESSING"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>
    
    <!-- Logger for Listeners with reduced verbosity -->
    <logger name="com.marmitt.listener" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>
    
    <!-- Logger for WebSocket connections -->
    <logger name="com.marmitt.ctrade.infrastructure.exchange" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>
    
    <!-- Reduce Spring Boot startup noise -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.context" level="WARN"/>
    <logger name="org.springframework.boot.autoconfigure" level="WARN"/>
    
    <!-- Reduce Netty noise -->
    <logger name="io.netty" level="WARN"/>
    
    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
    
</configuration>